generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(uuid())
  openId      String @unique
  type        Int    @default(0)
  nickname    String @default("")
  avatar      String @default("")
  phone       String @unique
  balance     BigInt @default(0)
  points      Int    @default(0)
  description String @default("")
  createdAt   BigInt @default(0)
  updatedAt   BigInt @default(0)
  deletedAt   BigInt @default(0)

  reservations Order[]

  @@map("users")
}

model Store {
  id          String  @id @default(uuid())
  type        Int     @default(0)
  name        String  @default("")
  address     String  @default("")
  province    String  @default("")
  city        String  @default("")
  district    String  @default("")
  longitude   Float   @default(0.0)
  latitude    Float   @default(0.0)
  seatCount   Int     @default(0)
  phone       String  @default("")
  is24Hours   Boolean @default(false)
  openTime    String  @default("06:00")
  closeTime   String  @default("23:59")
  isActive    Boolean @default(true)
  features    String  @default("") //特色亮点
  promotion   String  @default("") //促销活动
  price       Int     @default(0) //最低价格
  reviews     Int     @default(0) //评论数
  sales       Int     @default(0) //销量
  coverImages String  @default("") //封面图
  description String  @default("")
  createdAt   BigInt  @default(0)
  updatedAt   BigInt  @default(0)
  deletedAt   BigInt  @default(0)

  areas Area[]
  seats Seat[]

  @@map("stores")
}

model Area {
  id          String  @id @default(uuid())
  storeId     String  @default("")
  name        String  @default("")
  seatCount   Int     @default(0)
  sort        Int     @default(0)
  isActive    Boolean @default(true)
  description String  @default("")
  createdAt   BigInt  @default(0)
  updatedAt   BigInt  @default(0)
  deletedAt   BigInt  @default(0)

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@index([storeId])
  @@map("areas")
}

model Seat {
  id          String  @id @default(uuid())
  storeId     String  @default("")
  areaId      String  @default("")
  type        Int     @default(0)
  seatNo      String  @default("")
  x           Float   @default(0.0)
  y           Float   @default(0.0)
  width       Float   @default(0.0)
  height      Float   @default(0.0)
  hasPower    Boolean @default(true)
  status      Int     @default(0)
  description String  @default("")
  createdAt   BigInt  @default(0)
  updatedAt   BigInt  @default(0)
  deletedAt   BigInt  @default(0)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  area   Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([areaId, seatNo])
  @@index([areaId])
  @@map("seats")
}

model Order {
  id        String @id @default(uuid())
  storeId   String @default("")
  seatId    String @default("")
  category  Int    @default(0)
  userId    String @default("")
  type      Int    @default(0)
  startTime BigInt @default(0)
  endTime   BigInt @default(0)
  status    Int    @default(0)
  createdAt BigInt @default(0)
  updatedAt BigInt @default(0)
  deletedAt BigInt @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([seatId])
  @@map("orders")
}
